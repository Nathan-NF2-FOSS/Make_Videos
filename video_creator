from moviepy.editor import ImageClip, AudioFileClip

# 1. Load the image and set its duration (e.g., 10 seconds)
image_path = "your_image.png"
duration = 10.0  # seconds
image_clip = ImageClip(image_path).set_duration(duration)

# 2. Load the background music
audio_path = "your_music.mp3"
audio_clip = AudioFileClip(audio_path).subclip(0, duration)

# 3. Combine image and audio
video_clip = image_clip.set_audio(audio_clip)

# 4. Write the result to a file
video_clip.write_videofile("looping_video.mp4", fps=24)
